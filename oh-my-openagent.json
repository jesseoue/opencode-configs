  "background_task": {
    "defaultConcurrency": 10,
    "providerConcurrency": {
      "openrouter": 12
    },
    "modelConcurrency": {
      "openrouter/z-ai/glm-5.3": 8,
      "openrouter/poolside/laguna-s-2.1": 10,
      "openrouter/meituan/longcat-2.0": 8,
      "openrouter/minimax/minimax-m3": 8,
      "openrouter/google/gemini-3.1-pro-preview": 5,
      "openrouter/google/gemini-3.7-flash": 10,
      "openrouter/qwen/qwen3.8-max": 5,
      "openrouter/moonshotai/kimi-k2.7-code": 5,
      "openrouter/deepseek/deepseek-v4-pro-0813": 5,
      "openrouter/deepseek/deepseek-v4-flash-0731": 10,
      "openrouter/nousresearch/hermes-4-405b": 2
    },
    "maxDepth": 2,
    "staleTimeoutMs": 180000,
    "sessionGoneTimeoutMs": 30000,
    "taskCleanupDelayMs": 60000,
    "syncPollTimeoutMs": 60000,
    "maxToolCalls": 200,
    "circuitBreaker": {
      "enabled": true,
      "maxToolCalls": 160,
      "consecutiveThreshold": 8
    },
    "messageStalenessTimeoutMs": 180000,
    "taskTtlMs": 1800000
  },
  "team_mode": {
    "enabled": true,
    "tmux_visualization": false,
    "max_parallel_members": 4,
    "max_members": 5,
    "max_messages_per_run": 2000,
    "max_wall_clock_minutes": 45,
    "max_member_turns": 150,
    "base_dir": "~/.omo",
    "message_payload_max_bytes": 32768,
    "recipient_unread_max_bytes": 262144,
    "mailbox_poll_interval_ms": 1000
  },
  "runtime_fallback": {
    "enabled": false,
    "retry_on_errors": [
      408,
      429,
      500,
      502,
      503,
      504
    ],
    "max_fallback_attempts": 3,
    "cooldown_seconds": 10,
    "timeout_seconds": 120,
    "notify_on_fallback": true,
    "restore_primary_after_cooldown": true
  },
  "sisyphus_agent": {
    "disabled": false,
    "default_builder_enabled": false,
    "planner_enabled": true,
    "replace_plan": true,
    "tdd": true
  },
  "sisyphus": {
    "tasks": {
      "storage_path": ".sisyphus/tasks",
      "claude_code_compat": false
    }
  },
  "git_master": {
    "commit_footer": false,
    "include_co_authored_by": false
  },
  "codegraph": {
    "enabled": true,
    "auto_init": false,
    "auto_provision": true,
    "telemetry": false,
    "daemon": true
  },
  "model_capabilities": {
    "enabled": true,
    "auto_refresh_on_start": false,
    "source_url": "https://openrouter.ai/api/v1/models"
  },
  "keyword_detector": {
    "enabled_expansions": [
      "ultrawork",
      "team",
      "hyperplan",
      "hyperplan-ultrawork"
    ]
  },
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "isolation": "inline",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  },
  "browser_automation_engine": {
    "provider": "playwright"
  },
  "notification": {
    "force_enable": true
  },
  "start_work": {
    "auto_commit": false
  },
  "babysitting": {
    "timeout_ms": 180000
  },
  "experimental": {
    "task_system": true,
    "preemptive_compaction": true,
    "model_fallback_title": true,
    "disable_omo_env": true,
    "max_tools": 48,
    "dynamic_context_pruning": {
      "enabled": true,
      "notification": "minimal",
      "turn_protection": {
        "enabled": true,
        "turns": 2
      },
      "strategies": {
        "deduplication": {
          "enabled": true
        },
        "supersede_writes": {
          "enabled": true
        },
        "purge_errors": {
          "enabled": true,
          "turns": 2
        }
      }
    },
    "aggressive_truncation": false,
    "truncate_all_tool_outputs": false,
    "safe_hook_creation": true,
    "plugin_load_timeout_ms": 120000
  },
  "claude_code": {
    "mcp": false,
    "commands": false,
    "skills": false,
    "agents": false,
    "hooks": false,
    "plugins": false,
    "anthropic_provider": "openrouter"
  },
  "disabled_skills": [
    "security-research",
    "security-review"
  ],
  "disabled_agents": [
    "build"
  ],
  "disabled_mcps": [
    "agentmemory:agentmemory",
    "playwright:playwright",
    "posthog:posthog",
    "vercel:vercel",
    "sentry:sentry",
    "slack:slack",
    "stripe:stripe",
    "supabase:supabase",
    "clerk:clerk",
    "axiom:axiom"
  ],
  "skills": {
    "sources": [
      "~/.config/opencode/skills",
      "./skills"
    ]
  },
  "disabled_tools": [
    "interactive_bash",
    "monitor_start",
    "monitor_stop",
    "monitor_output",
    "monitor_list",
    "session_list",
    "session_search"
  ],
  "goal": {
    "enabled": false,
    "auto_start": false,
    "default_max_iterations": 24
  },
  "default_mode": {
    "ultrawork": false,
    "goal": false
  },
  "mcp_env_allowlist": [],
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json"
}
