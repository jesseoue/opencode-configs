    "explore": {
      "mode": "subagent",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "webfetch": "allow",
        "question": "allow",
        "task": "allow"
      },
      "prompt_append": "file://~/.config/opencode/prompts/agents/explore.md",
      "color": "#FFD400",
      "maxTokens": 8192,
      "model": "openrouter/z-ai/glm-5.3",
      "reasoning": "high",
      "fallback_models": [
