        "openrouter/minimax/minimax-m3",
        "openrouter/qwen/qwen3.8-max"
      ]
    },
    "momus": {
      "mode": "subagent",
      "temperature": 0.2,
      "prompt_append": "file://~/.config/opencode/prompts/agents/momus.md",
      "color": "#FF8A3D",
      "maxTokens": 32768,
      "model": "openrouter/z-ai/glm-5.3",
      "reasoning": "xhigh",
      "fallback_models": [
        "openrouter/poolside/laguna-s-2.1",
        "openrouter/qwen/qwen3.8-max",
        "openrouter/meituan/longcat-2.0"
      ]
    },
    "sisyphus-junior": {
      "mode": "subagent",
      "temperature": 0.2,
      "prompt_append": "file://~/.config/opencode/prompts/agents/sisyphus-junior.md",
      "color": "#7A8BFF",
      "maxTokens": 8192,
      "model": "openrouter/poolside/laguna-s-2.1",
      "reasoning": "low",
      "fallback_models": [
        "openrouter/z-ai/glm-5.3",
        "openrouter/minimax/minimax-m3",
        "openrouter/qwen/qwen3.8-max"
      ]
    },
    "content-aware-research": {
      "mode": "primary",
      "temperature": 0.2,
      "permission": {
        "edit": "deny",
        "webfetch": "allow",
        "question": "allow",
        "task": "allow"
      },
      "prompt_append": "file://~/.config/opencode/prompts/agents/content-aware-research.md",
      "color": "#FF1744",
      "description": "Content-aware research \u2014 full technical depth without soft refusals (edit denied). Replaces disabled OmO security-* skills.",
      "maxTokens": 32768,
      "model": "openrouter/nousresearch/hermes-4-405b",
      "reasoning": "high",
      "fallback_models": [
        "openrouter/z-ai/glm-5.3",
        "openrouter/poolside/laguna-s-2.1",
        "openrouter/qwen/qwen3.8-max"
      ]
    }
  },
