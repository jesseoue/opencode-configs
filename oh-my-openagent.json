      "maxTokens": 32768,
      "model": "openrouter/z-ai/glm-5.3",
      "reasoning": "high",
      "fallback_models": [
        "openrouter/qwen/qwen3.8-max",
        "openrouter/poolside/laguna-s-2.1",
        "openrouter/meituan/longcat-2.0"
      ]
    },
    "librarian": {
      "mode": "subagent",
      "temperature": 0.1,
      "prompt_append": "file://~/.config/opencode/prompts/agents/librarian.md",
      "color": "#00FFD1",
      "maxTokens": 8192,
