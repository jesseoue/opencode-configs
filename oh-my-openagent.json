{
  "hashline_edit": true,
  "telemetry": false,
  "default_run_agent": "sisyphus",
  "auto_update": false,
  "model_fallback": false,
  "websearch": {
    "provider": "exa"
  },
  "agent_order": [
    "sisyphus",
    "hephaestus",
    "prometheus",
    "atlas",
    "content-aware-research"
  ],
  "agents": {
    "sisyphus": {
      "mode": "primary",
      "ultrawork": {
        "model": "openrouter/z-ai/glm-5.3",
        "variant": "max"
      },
      "temperature": 0.25,
      "prompt_append": "file://~/.config/opencode/prompts/agents/sisyphus.md",
      "color": "#00F0FF",
      "maxTokens": 8192,
      "model": "openrouter/z-ai/glm-5.3",
      "reasoning": "low",
      "fallback_models": [
        "openrouter/moonshotai/kimi-k2.7-code",
        "openrouter/poolside/laguna-s-2.1",
        "openrouter/qwen/qwen3.8-max"
      ]
    },
    "hephaestus": {
      "mode": "primary",
      "temperature": 0.2,
      "permission": {
        "teammate": "allow"
      },
      "prompt_append": "file://~/.config/opencode/prompts/agents/hephaestus.md",
      "color": "#FF5C00",
      "maxTokens": 32768,
      "model": "openrouter/z-ai/glm-5.3",
      "reasoning": "high",
      "fallback_models": [
        "openrouter/qwen/qwen3.8-max",
        "openrouter/poolside/laguna-s-2.1",
        "openrouter/meituan/longcat-2.0"
      ]
    },
    "prometheus": {
      "mode": "primary",
      "temperature": 0.25,
      "prompt_append": "file://~/.config/opencode/prompts/agents/prometheus.md",
      "color": "#B967FF",
      "maxTokens": 8192,
      "model": "openrouter/z-ai/glm-5.3",
      "reasoning": "low",
      "fallback_models": [
        "openrouter/poolside/laguna-s-2.1",
        "openrouter/minimax/minimax-m3",
        "openrouter/qwen/qwen3.8-max"
      ]
    },
    "atlas": {
      "mode": "primary",
      "temperature": 0.2,
      "prompt_append": "file://~/.config/opencode/prompts/agents/atlas.md",
      "color": "#39FF14",
      "maxTokens": 8192,
