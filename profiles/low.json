{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/z-ai/glm-5.3",
  "small_model": "openrouter/poolside/laguna-s-2.1",
  "default_agent": "sisyphus",
  "instructions": [
    "../AGENTS.md",
    "../prompts/core.md",
    "../prompts/profiles/low.md"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 32000,
    "tail_turns": 3,
    "preserve_recent_tokens": 16000
  },
  "tool_output": {
    "max_lines": 300,
    "max_bytes": 12000
  }
}
