{
  "$schema": "https://opencode.ai/config.json",
  "model": "venice/deepseek-v4-pro-0813",
  "small_model": "venice/deepseek-v4-pro-0813",
  "default_agent": "content-aware-research",
  "permission": {
    "edit": "deny",
    "webfetch": "allow",
    "question": "allow",
    "task": "allow"
  },
  "instructions": [
    "../AGENTS.md",
    "../prompts/core.md",
    "../prompts/profiles/content-aware.md"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 40000,
    "tail_turns": 4,
    "preserve_recent_tokens": 16000
  },
  "tool_output": {
    "max_lines": 400,
    "max_bytes": 16000
  }
}
