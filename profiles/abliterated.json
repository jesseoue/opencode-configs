{
  "$schema": "https://opencode.ai/config.json",
  "model": "venice/abliteration-abliterated-model-large-v2",
  "small_model": "venice/abliteration-abliterated-model-large-flash",
  "default_agent": "lead",
  "agent": {
    "title": {
      "model": "venice/abliteration-abliterated-model-large-flash",
      "temperature": 0.1,
      "steps": 1
    },
    "summary": {
      "model": "venice/abliteration-abliterated-model-large-flash",
      "temperature": 0.2,
      "steps": 1
    },
    "compaction": {
      "model": "venice/abliteration-abliterated-model-large-flash",
      "temperature": 0.1,
      "steps": 1
    }
  },
  "instructions": [
    "../AGENTS.md",
    "../prompts/core.md",
    "../prompts/profiles/abliterated.md"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 24000,
    "tail_turns": 3,
    "preserve_recent_tokens": 8000
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8000
  }
}
